{
  "name": "texflow",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first LaTeX IDE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iang06112005/Leaf.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,companion -c cyan,magenta \"vite\" \"node companion/server.mjs\"",
    "dev:web": "vite",
    "companion": "node companion/server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && node --test companion/lib/tex.test.mjs companion/lib/synctex.test.mjs companion/lib/template.test.mjs",
    "test:compile": "node scripts/compile-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.554.0",
    "monaco-editor": "^0.57.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.16",
    "vitest": "^4.0.6"
  }
}
